APP_NAME="Buildora CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=buildora_cms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BCRYPT_ROUNDS=12
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

VITE_APP_NAME="${APP_NAME}"

CMS_PRODUCT_NAME="Buildora CMS"
CMS_PRODUCT_SHORT_NAME="Buildora"
CMS_VERSION=1.0.0
CMS_SEED_MODE=clean
CMS_ALLOW_DEMO_SEED_IN_PRODUCTION=false
CMS_ALLOW_DEMO_SEED_WITH_EXISTING_DATA=false

# Licensing is provider-neutral and opt-in until a distribution enables it.
# Only the offline signed-token adapter ships as operational in this release.
CMS_LICENSE_ENFORCE=false
CMS_LICENSE_PROVIDER=offline
CMS_LICENSE_PRODUCT_ID=buildora-cms
CMS_LICENSE_OFFLINE_PUBLIC_KEY=

CMS_RUNTIME_DEMO_MODE=false

# Portal activation remains off until the official Naxas service passes acceptance testing.
CMS_NAXAS_PORTAL_ENABLED=false
CMS_NAXAS_LICENSE_SERVER_URL=https://licenses.naxasltd.com
CMS_NAXAS_ALLOW_HTTP_LOCAL=false
